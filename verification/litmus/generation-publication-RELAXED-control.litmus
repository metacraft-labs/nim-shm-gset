C generation-publication-RELAXED-control
(* The successful publication CAS releases prior producer state. The host
 * acquire-read of the policy word observes it before consuming evidence.
 * The actual C unit, including CAS failure and binding/reset paths, is also
 * checked directly by generation_publisher_driver.c under GenMC. *)
{
  payload = 0;
  word = 0;
  expected = 0;
}
P0 (atomic_int *payload, atomic_int *word, int *expected) {
  atomic_store_explicit(payload, 42, memory_order_relaxed);
  atomic_compare_exchange_strong_explicit(word, expected, 1, memory_order_relaxed, memory_order_relaxed);
}
P1 (atomic_int *payload, atomic_int *word) {
  int r0 = atomic_load_explicit(word, memory_order_acquire);
  int r1 = atomic_load_explicit(payload, memory_order_relaxed);
}
exists (1:r0=1 /\ 1:r1=0)
